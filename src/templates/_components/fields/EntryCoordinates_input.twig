{% import "_includes/forms" as forms %}
{% set suffix = random() %}

{% if value is empty %}
    {% set value = {
        searchQuery: "",
        coordinates: "",
        address: "",
        zoomLevel: "",
    } %}
{% endif %}

<div style="display: flex; align-items: center; margin-bottom: 10px;">
    <label style="margin-right: 10px;">{{ 'Search'|t('entry-gps-coordinates') }}:</label>
    {{ forms.text({
        id: 'location-search-' ~ suffix,
        class: 'location-search-' ~ suffix,
        name: name ~ '[searchQuery]',
        value: value.searchQuery,
        placeholder: 'Search Address'|t('entry-gps-coordinates')
    }) }}
</div>





<style>
    /* Always set the map height explicitly to define the size of the div
     * element that contains the map. */
    .fields-map {
        width: 100%;
        height: 400px;
    }
</style>


<div class="fields-map fields-map-{{ suffix }}"></div>

<div style="margin-top: 10px; display: flex; align-items: center; margin-bottom: 10px;">
    <label style="margin-right: 10px;">{{ 'Coordinates'|t('entry-gps-coordinates') }}:</label>
    {{ forms.text({
        id: name,
        class: 'location-coords-' ~ suffix,
        name: name ~ '[coordinates]',
        value: value.coordinates
    }) }}
    <label style="margin-left: 10px; margin-right: 10px;">{{ 'Address'|t('entry-gps-coordinates') }}:</label>
    {{ forms.text({
        id: name,
        class: 'location-address-' ~ suffix,
        name: name ~ '[address]',
        value: value.address
    }) }}

    {{ tag('input', {
        type: 'hidden',
        id: name,
        class: 'location-zoom-' ~ suffix,
        name: name ~ '[zoomLevel]',
        value: value.zoomLevel
    }) }}
    {{ tag('input', {
        type: 'hidden',
        class: 'location-street-number-' ~ suffix,
        name: name ~ '[streetNumber]',
        value: value.streetNumber ?? ''
    }) }}
    {{ tag('input', {
        type: 'hidden',
        class: 'location-route-' ~ suffix,
        name: name ~ '[route]',
        value: value.route ?? ''
    }) }}
    {{ tag('input', {
        type: 'hidden',
        class: 'location-locality-' ~ suffix,
        name: name ~ '[locality]',
        value: value.locality ?? ''
    }) }}
    {{ tag('input', {
        type: 'hidden',
        class: 'location-postal-code-' ~ suffix,
        name: name ~ '[postalCode]',
        value: value.postalCode ?? ''
    }) }}
    {{ tag('input', {
        type: 'hidden',
        class: 'location-country-' ~ suffix,
        name: name ~ '[country]',
        value: value.country ?? ''
    }) }}

    <input type="button" value="{{ 'Delete Marker'|t('entry-gps-coordinates') }}" class="location-delete-{{ suffix }} btn" style="margin-left: 10px;">
</div>

{% js %}
    EntryCoordinates.setApiKey('{{ googleApiKey }}');
    EntryCoordinates.setLanguage('{{ uiLanguage }}');
    EntryCoordinates.addField('{{ name }}', { suffix: '{{ suffix }}', originalLocation: '{{ value.coordinates }}', zoomLevel: '{{ value.zoomLevel }}', defaultCenterCoordinates: '{{ defaultCenterCoordinates }}', defaultZoomLevel: '{{ defaultZoomLevel ?? 1 }}', apiKey: '{{ googleApiKey }}', language: '{{ language }}'});
{% endjs %}